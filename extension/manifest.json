{
  "manifest_version": 3,
  "name": "PasteAndSave - Video Downloader",
  "version": "2.0.1",
  "description": "Puts a Save button on the videos you watch, and spots downloadable video and audio on any page. Save files directly, or send a page to PasteAndSave for MP4 and MP3.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "downloads",
    "webRequest",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save with PasteAndSave",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "send-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Send the current page to PasteAndSave"
    }
  }
}
