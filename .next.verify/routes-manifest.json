{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.pasteandsave.com"
        }
      ],
      "destination": "https://pasteandsave.com/:path*",
      "statusCode": 308,
      "regex": "^(?!/_next)(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-App-Version",
          "value": "2026.07.30"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/:key([a-fA-F0-9-]{8,64}).txt",
        "destination": "/indexnow/:key",
        "regex": "^(?:/([a-fA-F0-9-]{8,64}))\\.txt(?:/)?$"
      }
    ],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/jobs/[jobId]/events",
      "regex": "^/api/jobs/([^/]+?)/events(?:/)?$",
      "routeKeys": {
        "nxtPjobId": "nxtPjobId"
      },
      "namedRegex": "^/api/jobs/(?<nxtPjobId>[^/]+?)/events(?:/)?$"
    },
    {
      "page": "/api/jobs/[jobId]/file",
      "regex": "^/api/jobs/([^/]+?)/file(?:/)?$",
      "routeKeys": {
        "nxtPjobId": "nxtPjobId"
      },
      "namedRegex": "^/api/jobs/(?<nxtPjobId>[^/]+?)/file(?:/)?$"
    },
    {
      "page": "/blog/[slug]",
      "regex": "^/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/blog/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/indexnow/[key]",
      "regex": "^/indexnow/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkey": "nxtPkey"
      },
      "namedRegex": "^/indexnow/(?<nxtPkey>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[tool]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtool": "nxtPtool"
      },
      "namedRegex": "^/(?<nxtPtool>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[tool]/opengraph-image",
      "regex": "^/([^/]+?)/opengraph\\-image(?:/)?$",
      "routeKeys": {
        "nxtPtool": "nxtPtool"
      },
      "namedRegex": "^/(?<nxtPtool>[^/]+?)/opengraph\\-image(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
