# Copy this file to .env.local (dev) or set these on your server (prod).

# Public site URL, used for canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Absolute path to the folder holding yt-dlp and ffmpeg. Optional; defaults to
# ./bin relative to the app. Set this if you deploy with standalone output.
# On a Linux host, download the Linux builds (yt-dlp and ffmpeg without .exe).
# BIN_DIR=/srv/pasteandsave/bin

# --- YouTube reliability -------------------------------------------------
# YouTube blocks its default player client from datacenter/VPS IPs (the
# "Sign in to confirm you're not a bot" wall). These let you keep it working
# without changing code. KEEP yt-dlp UPDATED FIRST — most breakage is a stale
# binary. On the server: run scripts/update-ytdlp.sh (or `yt-dlp -U`) weekly.
#
# Player clients tried, in order. Override when YouTube shifts again.
# YTDLP_YOUTUBE_CLIENTS=tv,web_safari,mweb,android_vr
# YTDLP_YOUTUBE_FALLBACK_CLIENTS=default,tv,ios
#
# The durable fix for a blocked server IP: route yt-dlp through a residential
# or rotating proxy so requests don't come from the datacenter IP.
# YTDLP_PROXY=http://user:pass@proxy-host:port
#
# Escape hatch for any extra yt-dlp flags (a PO-token provider, a cookies file
# you manage yourself, geo options). Space separated, appended to every call.
# YTDLP_EXTRA_ARGS=--cookies /srv/pasteandsave/cookies.txt

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX).
# Leave blank to disable Google Analytics. First-party stats work either way.
NEXT_PUBLIC_GA_ID=

# Admin panel password. Choose a long, unique value.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign the admin session cookie. Must be at least 16 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Optional: Google Search Console + GA Data API in the admin panel ---
# One Google Cloud service account powers both. Download its JSON key, then
# base64-encode it and paste the result here (base64 avoids newline issues):
#   node -e "console.log(Buffer.from(require('fs').readFileSync('key.json')).toString('base64'))"
GOOGLE_SERVICE_ACCOUNT_JSON=

# GA4 numeric property id (Admin > Property Settings). NOT the G-XXXX id.
# The service account must be a Viewer on this GA4 property.
GA4_PROPERTY_ID=

# Search Console property. Use "https://your-domain.com/" for a URL-prefix
# property or "sc-domain:your-domain.com" for a domain property.
# The service account must be added as a user of this property.
GSC_SITE_URL=

# --- SEO autopilot (background audits + IndexNow) ---
# Base URL the crawler fetches to audit your own pages. Defaults to
# NEXT_PUBLIC_SITE_URL. Override only if the server reaches itself elsewhere,
# e.g. CRAWL_BASE_URL=http://localhost:3000 to skip the public round trip.
CRAWL_BASE_URL=

# How often the autopilot re-audits the site and pings IndexNow, in hours.
# Defaults to 24. Minimum 1.
SEO_AUTOPILOT_HOURS=

# IndexNow key. Leave blank to auto-generate one (persisted in data/).
# Set it only if you want the same key across multiple servers.
INDEXNOW_KEY=

# Optional bearer token so an external scheduler (cron, Windows Task Scheduler)
# can trigger an audit cycle: POST /api/admin/seo-report with
# "Authorization: Bearer <token>". The built-in autopilot works without it.
SEO_REPORT_TOKEN=
