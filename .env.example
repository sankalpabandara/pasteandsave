# Copy this file to .env.local and fill in real values.

# Public site URL, used for canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX).
# Leave blank to disable Google Analytics. First-party stats work either way.
NEXT_PUBLIC_GA_ID=

# Admin panel password. Choose a long, unique value.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign the admin session cookie. Must be at least 16 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Optional: Google Search Console + GA Data API in the admin panel ---
# One Google Cloud service account powers both. Download its JSON key, then
# base64-encode it and paste the result here (base64 avoids newline issues):
#   node -e "console.log(Buffer.from(require('fs').readFileSync('key.json')).toString('base64'))"
GOOGLE_SERVICE_ACCOUNT_JSON=

# GA4 numeric property id (Admin > Property Settings). NOT the G-XXXX id.
# The service account must be a Viewer on this GA4 property.
GA4_PROPERTY_ID=

# Search Console property. Use "https://your-domain.com/" for a URL-prefix
# property or "sc-domain:your-domain.com" for a domain property.
# The service account must be added as a user of this property.
GSC_SITE_URL=

# --- Weekly SEO site-audit crawler ---
# Base URL the crawler fetches to audit your own pages. Defaults to
# NEXT_PUBLIC_SITE_URL. Override only if the server reaches itself elsewhere.
CRAWL_BASE_URL=

# Optional bearer token so an external scheduler (cron, Windows Task Scheduler)
# can trigger the audit: POST /api/admin/seo-report with
# "Authorization: Bearer <token>". The in-app weekly scheduler works without it.
SEO_REPORT_TOKEN=
